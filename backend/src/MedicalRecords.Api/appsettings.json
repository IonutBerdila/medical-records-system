{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Enabled": true,
    "Endpoint": "https://api.openai.com/v1/chat/completions",
    "Model": "gpt-4o-mini",
    "TimeoutSeconds": 60,
    "MaxEntries": 20
  },
  "Assistant": {
    "MaxMessageLength": 2000,
    "MaxHistoryItems": 10,
    "MaxHistoryMessageLength": 2000,
    "MaxClarificationQuestions": 3,
    "MaxSuggestedSpecialties": 4,
    "MaxSuggestedDoctors": 6,
    "MaxDoctorsPerSpecialty": 3
  }
}
